# Copy to .env; pass --env-file .env to every compose command.
# Production: connect to the existing database; no PostgreSQL container is started.
# Same Linux host: host.docker.internal; remote DB: its private DNS/IP.
# URL-encode special characters in credentials. Never commit real credentials.
DATABASE_URL=

# Published host ports for docker-compose.yml (loopback only).
# Container ports stay fixed; update reverse proxy upstreams when changing these.
BACKEND_PORT=4000
FRONTEND_PORT=3000
ADMIN_PORT=3102

# Development PostgreSQL only (docker-compose.dev.yml).
# Use a random URL-safe password (letters, numbers, _ and -).
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# Required for the production backend. See mentor_admin/README.md.
ADMIN_LOGIN=
# Single quotes preserve literal $ characters in the scrypt hash.
ADMIN_PASSWORD_HASH=''
ADMIN_ORIGINS=http://localhost:3102
# For production, include https://mentor-tattoo.ru and the actual admin origin.
CORS_ORIGIN=http://localhost:3000,http://localhost:3102

# Browser-facing URLs; changing these requires rebuilding the images.
NEXT_PUBLIC_API_URL=http://localhost:4000
VITE_API_URL=http://localhost:4000
NEXT_PUBLIC_YANDEX_API=
# Server-only endpoint, including /articles (articles API is not implemented yet).
BLOG_API_URL=http://backend:4000/articles

# Leave SMTP empty for local work to avoid real notifications.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=
